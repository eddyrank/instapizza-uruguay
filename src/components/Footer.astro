---
import { business } from '../lib/business';

const quickLinks = [
  { label: 'Promos', href: '#promos' },
  { label: 'Menú', href: '#menu' },
  { label: 'Delivery', href: '#delivery' },
  { label: 'Por qué Instapizza', href: '#por-que-instapizza' },
  { label: 'Reseñas', href: '#resenas' },
  { label: 'Instagram', href: '#instagram' },
  { label: 'Ubicación', href: '#ubicacion' },
];

const year = new Date().getFullYear();
---

<footer class="border-t border-ink-700 bg-ink-900 text-cream-100">
  <div class="container-wide grid gap-10 px-4 py-14 sm:px-6 md:grid-cols-3 lg:px-8">
    <div>
      <p class="font-display text-2xl text-cream-50">
        Insta<span class="text-gold-400">pizza</span>
      </p>
      <p class="mt-3 max-w-xs text-sm text-cream-100/80">{business.tagline}.</p>
      <address class="not-italic mt-4 space-y-1 text-sm text-cream-100/80">
        <p>{business.address.full}</p>
        <p>
          <a href={business.phoneHref} class="transition hover:text-gold-400">{business.phoneDisplay}</a>
        </p>
      </address>
      <a
        href={business.social.instagram}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-4 inline-flex items-center gap-2 text-sm font-semibold text-cream-100/90 transition hover:text-gold-400"
      >
        <svg aria-hidden="true" viewBox="0 0 24 24" class="h-5 w-5 fill-current">
          <path
            d="M12 2.16c3.2 0 3.58.01 4.85.07 1.17.05 1.8.25 2.23.41.56.22.96.48 1.38.9.42.42.68.82.9 1.38.16.42.36 1.06.41 2.23.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.05 1.17-.25 1.8-.41 2.23-.22.56-.48.96-.9 1.38-.42.42-.82.68-1.38.9-.42.16-1.06.36-2.23.41-1.27.06-1.65.07-4.85.07s-3.58-.01-4.85-.07c-1.17-.05-1.8-.25-2.23-.41a3.72 3.72 0 0 1-1.38-.9 3.72 3.72 0 0 1-.9-1.38c-.16-.42-.36-1.06-.41-2.23-.06-1.27-.07-1.65-.07-4.85s.01-3.58.07-4.85c.05-1.17.25-1.8.41-2.23.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.9.42-.16 1.06-.36 2.23-.41 1.27-.06 1.65-.07 4.85-.07M12 0C8.74 0 8.33.01 7.05.07c-1.28.06-2.15.26-2.91.56a5.9 5.9 0 0 0-2.13 1.39A5.9 5.9 0 0 0 .62 4.14c-.3.76-.5 1.63-.56 2.91C0 8.33 0 8.74 0 12s.01 3.67.07 4.95c.06 1.28.26 2.15.56 2.91.31.79.72 1.46 1.39 2.13.67.67 1.34 1.08 2.13 1.39.76.3 1.63.5 2.91.56C8.33 24 8.74 24 12 24s3.67-.01 4.95-.07c1.28-.06 2.15-.26 2.91-.56a5.9 5.9 0 0 0 2.13-1.39 5.9 5.9 0 0 0 1.39-2.13c.3-.76.5-1.63.56-2.91.06-1.28.07-1.69.07-4.95s-.01-3.67-.07-4.95c-.06-1.28-.26-2.15-.56-2.91a5.9 5.9 0 0 0-1.39-2.13A5.9 5.9 0 0 0 19.86.63c-.76-.3-1.63-.5-2.91-.56C15.67.01 15.26 0 12 0zm0 5.84A6.16 6.16 0 1 0 18.16 12 6.16 6.16 0 0 0 12 5.84zm0 10.16A4 4 0 1 1 16 12a4 4 0 0 1-4 4zm6.41-10.4a1.44 1.44 0 1 1-1.44-1.44 1.44 1.44 0 0 1 1.44 1.44z"
          />
        </svg>
        @instapizza.delivery
      </a>
    </div>

    <div>
      <h2 class="text-sm font-display tracking-wide text-gold-400">Horario</h2>
      <ul class="mt-3 space-y-1 text-sm text-cream-100/80">
        {
          business.hours.map((h) => (
            <li class="flex justify-between gap-4">
              <span>{h.day}</span>
              <span>{h.opens ? `${h.opens} – ${h.closes}` : 'Cerrado'}</span>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <h2 class="text-sm font-display tracking-wide text-gold-400">Enlaces</h2>
      <nav aria-label="Navegación de pie de página" class="mt-3 flex flex-col gap-2 text-sm">
        {
          quickLinks.map((link) => (
            <a href={link.href} class="text-cream-100/80 transition hover:text-gold-400 w-fit">
              {link.label}
            </a>
          ))
        }
      </nav>
      <a href={business.whatsappHref} target="_blank" rel="noopener noreferrer" class="btn-primary mt-5 w-fit">
        Pedí por WhatsApp
      </a>
    </div>
  </div>

  <div class="border-t border-ink-700">
    <div class="container-wide px-4 py-5 text-xs text-cream-100/60 sm:px-6 lg:px-8">
      © {year} {business.name}. San Carlos, Maldonado, Uruguay.
    </div>
  </div>
</footer>
