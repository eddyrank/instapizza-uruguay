---
interface Props {
  label: string;
  value: string;
  detail?: string;
}

const { label, value, detail } = Astro.props;
---

<div class="rounded-xl border border-ink-700 bg-ink-900 p-6 text-center">
  <p class="text-xs font-semibold uppercase tracking-wide text-cream-100/60">{label}</p>
  <p class="mt-2 font-display text-2xl text-gold-400">{value}</p>
  {detail && <p class="mt-1 text-sm text-cream-100/70">{detail}</p>}
</div>
