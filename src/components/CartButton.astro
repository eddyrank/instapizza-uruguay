---
interface Props {
  variant?: 'icon' | 'full';
}

const { variant = 'icon' } = Astro.props;
---

{
  variant === 'icon' ? (
    <button
      type="button"
      data-cart-open
      aria-label="Ver mi pedido"
      class="relative flex h-11 w-11 items-center justify-center rounded-md border border-ink-600 text-cream-50 transition hover:border-gold-500 hover:text-gold-400"
    >
      <svg aria-hidden="true" viewBox="0 0 24 24" class="h-5 w-5 stroke-current" fill="none" stroke-width="2">
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M3 3h2l.4 2M7 13h10l3-8H6.4M7 13L5.4 5M7 13l-1.5 6h11M9 21a1 1 0 100-2 1 1 0 000 2zm8 0a1 1 0 100-2 1 1 0 000 2z"
        />
      </svg>
      <span
        data-role="cart-badge"
        class="absolute -right-1.5 -top-1.5 hidden h-5 min-w-5 items-center justify-center rounded-full bg-sauce-500 px-1 text-[11px] font-bold text-cream-50"
      >
        <span data-role="cart-count">0</span>
      </span>
    </button>
  ) : (
    <button
      type="button"
      data-cart-open
      class="mt-2 flex w-full items-center justify-between rounded-md border border-ink-600 px-3 py-3 text-base font-semibold uppercase tracking-wide text-cream-100 transition hover:border-gold-500 hover:text-gold-400"
    >
      <span>Mi pedido</span>
      <span
        data-role="cart-badge"
        class="hidden min-w-[1.5rem] rounded-full bg-sauce-500 px-2 py-0.5 text-center text-xs font-bold text-cream-50"
      >
        <span data-role="cart-count">0</span>
      </span>
    </button>
  )
}
