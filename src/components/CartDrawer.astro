---
import { business } from '../lib/business';
---

<div
  id="cart-overlay"
  class="fixed inset-0 z-[60] hidden bg-ink-950/80 backdrop-blur-sm"
  data-cart-close
  aria-hidden="true"
>
</div>

<div
  id="cart-drawer"
  class="fixed inset-x-0 bottom-0 z-[70] hidden max-h-[85vh] overflow-y-auto rounded-t-2xl border-t border-ink-700 bg-ink-900 p-6 sm:inset-x-auto sm:bottom-4 sm:right-4 sm:w-96 sm:rounded-2xl sm:border"
  role="dialog"
  aria-modal="true"
  aria-labelledby="cart-drawer-title"
  aria-hidden="true"
>
  <div class="flex items-center justify-between">
    <h2 id="cart-drawer-title" class="font-display text-xl normal-case tracking-normal text-cream-50">Tu pedido</h2>
    <button
      type="button"
      id="cart-close"
      data-cart-close
      aria-label="Cerrar pedido"
      class="flex h-10 w-10 items-center justify-center rounded-md text-cream-100 transition hover:text-gold-400"
    >
      <svg aria-hidden="true" viewBox="0 0 24 24" class="h-5 w-5 stroke-current" fill="none" stroke-width="2">
        <path stroke-linecap="round" d="M6 6l12 12M18 6L6 18" />
      </svg>
    </button>
  </div>

  <p id="cart-drawer-empty" class="mt-6 text-sm text-cream-100/70">
    Tu pedido está vacío. Elegí productos del <a href="#menu" data-cart-close class="text-gold-400 underline">menú</a> y
    sumalos con el botón +.
  </p>

  <ul id="cart-drawer-list" class="mt-4 hidden divide-y divide-ink-700"></ul>

  <div class="mt-5">
    <label for="cart-notes" class="text-xs font-semibold uppercase tracking-wide text-cream-100/60">
      Notas / dirección (opcional)
    </label>
    <textarea
      id="cart-notes"
      rows="2"
      placeholder="Ej: media muzza media napolitana, sin cebolla, Calle 25 de Agosto 123"
      class="mt-1 w-full rounded-md border border-ink-600 bg-ink-950 p-2 text-sm text-cream-50 placeholder:text-cream-100/40 focus:border-gold-500 focus:outline-none"
    ></textarea>
  </div>

  <div class="mt-5 flex items-center justify-between text-sm">
    <span class="text-cream-100/70">Total estimado</span>
    <span class="price-tag text-xl" data-role="cart-total">$0</span>
  </div>

  <a
    id="cart-checkout-link"
    href={business.whatsappHref}
    target="_blank"
    rel="noopener noreferrer"
    class="btn-primary mt-4 w-full"
  >
    Enviar pedido por WhatsApp
  </a>
  <button type="button" data-cart-clear class="mt-3 w-full text-center text-xs text-cream-100/50 underline">
    Vaciar pedido
  </button>
</div>

<script>
  import '../scripts/cart.ts';
</script>
