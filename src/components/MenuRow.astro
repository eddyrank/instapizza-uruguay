---
import OrderStepper from './OrderStepper.astro';
import { slugify } from '../lib/slug';

interface PriceEntry {
  label?: string;
  value: number | null;
}

interface Props {
  id: string; // base slug for this item, unique across the whole menu
  name: string;
  description?: string;
  prices: PriceEntry[];
}

const { id, name, description, prices } = Astro.props;
---

<div class="flex flex-col gap-3 border-b border-ink-700 py-4 last:border-0 sm:flex-row sm:items-start sm:justify-between sm:gap-6">
  <div class="sm:max-w-md">
    <h3 class="font-sans text-base font-bold normal-case tracking-normal text-cream-50">{name}</h3>
    {description && <p class="mt-1 text-sm text-cream-100/70">{description}</p>}
  </div>
  <div class="flex flex-wrap shrink-0 gap-4 sm:flex-col sm:items-end sm:gap-3">
    {
      prices.map((p) => {
        const entryId = p.label ? `${id}-${slugify(p.label)}` : id;
        const entryName = p.label ? `${name} (${p.label})` : name;
        return (
          <div class="flex items-center gap-3 sm:justify-end">
            {p.label && <span class="text-xs uppercase tracking-wide text-cream-100/60">{p.label}</span>}
            <span class="price-tag text-lg">{p.value !== null ? `$${p.value}` : 'Consultar'}</span>
            {p.value !== null && <OrderStepper id={entryId} name={entryName} price={p.value} />}
          </div>
        );
      })
    }
  </div>
</div>
