---
interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  align?: 'center' | 'left';
  light?: boolean;
}

const { eyebrow, title, subtitle, align = 'center', light = false } = Astro.props;
---

<div class={align === 'center' ? 'mx-auto max-w-2xl text-center' : 'max-w-2xl'}>
  {eyebrow && <p class="font-script text-2xl text-sauce-400">{eyebrow}</p>}
  <h2 class="mt-1 text-3xl sm:text-4xl">{title}</h2>
  {subtitle && <p class={`mt-3 text-base ${light ? 'text-cream-100/80' : 'text-cream-100/80'}`}>{subtitle}</p>}
</div>
