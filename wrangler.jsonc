// Cloudflare Workers config. Cloudflare's Git integration (Workers Builds)
// runs `npm run build` then `npx wrangler deploy` on every push to main,
// which uploads ./dist as static assets to the existing
// "instapizza-uruguay" Worker.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "instapizza-uruguay",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
